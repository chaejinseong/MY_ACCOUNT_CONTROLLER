# 이 파일은 git에 커밋된다 — 실제 비밀값은 절대 넣지 말 것.
# 로컬 개발 시 `.env`로 복사한 뒤 필요한 값을 채운다.

# 로컬 개발용 placeholder. 실제 Postgres가 준비되면 값 교체.
DATABASE_URL="postgresql://user:password@localhost:5432/account_manager?schema=public"

# 세션 쿠키 서명용 비밀키. 로컬 개발용 placeholder — 배포 전 반드시 랜덤 값으로 교체.
SESSION_SECRET="dev-only-change-me"

# Google Cloud Console에서 OAuth 클라이언트 등록 후 값 교체 (기획서/기술설계서 1장 참고).
# 앱 로그인(/auth/google/*)과 Gmail 연동(/email-accounts/oauth/*)이 클라이언트 1개를 공용으로 쓴다.
GOOGLE_CLIENT_ID="REPLACE_ME"
GOOGLE_CLIENT_SECRET="REPLACE_ME"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# WebAuthn(생체인증) 설정. RP_ID는 프론트엔드가 서비스되는 도메인(포트 제외), RP_ORIGIN은
# 프론트엔드 origin 전체. apps/web이 실제 배포되면 값 교체 필요.
WEBAUTHN_RP_NAME="통합 계정관리 프로그램"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:3000"

# apps/web(Next.js) 개발 서버 origin. CORS 허용 + Google OAuth 콜백 후 리다이렉트 대상으로 쓴다.
# 프론트가 실제 배포되면 그 도메인으로 교체.
FRONTEND_ORIGIN="http://localhost:3000"
